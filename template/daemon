#!/system/bin/sh

MODDIR=${0%/*}
STATE_DIR=/data/adb/omk
RESTART_FILE=$STATE_DIR/restart.keymint
PEER_RESTART_FILE=$STATE_DIR/restart.injector
RESTART_ALL_FILE=$STATE_DIR/restart.all

export LD_LIBRARY_PATH="/apex/com.android.runtime/lib64:/apex/com.android.runtime/lib64/bionic:/system/lib64:/vendor/lib64:$LD_LIBRARY_PATH"

find_module_keymint() {
  if [ -f "/data/adb/omk/keymint" ]; then
    echo /data/adb/omk/keymint
    return 0
  fi
  if [ -f "$MODDIR/keymint" ]; then
    echo "$MODDIR/keymint"
    return 0
  fi
  if [ -f "$MODDIR/libs/arm64-v8a/keymint" ]; then
    echo "$MODDIR/libs/arm64-v8a/keymint"
    return 0
  fi
  if [ -f "$MODDIR/libs/x86_64/keymint" ]; then
    echo "$MODDIR/libs/x86_64/keymint"
    return 0
  fi
  return 1
}

expand_shared_restart() {
  if [ -f "$RESTART_ALL_FILE" ]; then
    : > "$RESTART_FILE"
    : > "$PEER_RESTART_FILE"
    rm -f "$RESTART_ALL_FILE"
  fi
}

consume_restart_request() {
  expand_shared_restart

  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    return 0
  fi

  return 1
}

cd "$MODDIR" || exit 1
mkdir -p "$STATE_DIR"

failures=0

# Conservative exponential backoff for repeat crashes, counting consecutive
# fast failures the way soterta.sh counts its g_failures: 2s, 5s, 15s, 60s cap.
backoff_sleep() {
  case "$1" in
    ''|*[!0-9]*) delay=2 ;;
    0) delay=2 ;;
    1) delay=5 ;;
    2) delay=15 ;;
    *) delay=60 ;;
  esac
  sleep "$delay"
}

while true; do
  TARGET=$(find_module_keymint)
  if [ -z "$TARGET" ]; then
    echo "[keymint-daemon] keymint binary not found"
    sleep 5
    continue
  fi

  chmod 0755 "$TARGET"

  started_at=$(date +%s 2>/dev/null)
  "$TARGET" "$@" &
  child_pid=$!

  restart_requested=0
  while kill -0 "$child_pid" 2>/dev/null; do
    if consume_restart_request; then
      echo "[keymint-daemon] restart requested"
      restart_requested=1
      kill -TERM "$child_pid" 2>/dev/null
      sleep 2
      if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null
      fi
      break
    fi
    sleep 2
  done

  wait "$child_pid"
  rc=$?
  echo "[keymint-daemon] keymint exited with code $rc"
  now=$(date +%s 2>/dev/null)
  # Only a fast crash counts toward the backoff: an exit inside five seconds
  # carrying a non-zero status. A clean exit (rc=0), an exit past five seconds,
  # or an unreadable clock breaks the streak back to the plain 2s pause, while
  # the loop keeps restarting either way. A restart we were asked for is never
  # a crash: the TERM above leaves rc=143, so the streak resets instead.
  if [ "$restart_requested" = 1 ]; then
    failures=0
  elif [ -n "$started_at" ] && [ -n "$now" ] && [ $((now - started_at)) -lt 5 ] && [ "$rc" -ne 0 ]; then
    failures=$((failures + 1))
  else
    failures=0
  fi
  backoff_sleep "$failures"
done
